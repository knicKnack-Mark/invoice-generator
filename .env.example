# --- App identity ---
APP_NAME=VA Invoice & Expense Tracker
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1

# --- Database / cache ---
DATABASE_URL=postgresql+asyncpg://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS (comma-separated list of allowed frontend origins) ---
CORS_ORIGINS=http://localhost:3000

# --- Pagination ---
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- File storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads
# For AWS S3: set STORAGE_BACKEND=s3, bucket, region, and optional endpoint.
# For Cloudflare R2: set STORAGE_BACKEND=r2, endpoint, bucket, credentials,
# and STORAGE_REGION=auto.
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,application/pdf,image/heic

# --- Email ---
EMAIL_BACKEND=console
EMAIL_FROM_ADDRESS=billing@example.com
RESEND_API_KEY=
# Gmail SMTP: use a Google App Password (not your normal account password).
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
